# ==============================================================================
# Examination Management Portal (EMP) - Environment Configuration Template
# Copy this file to '.env' and populate with your environment-specific values.
# ==============================================================================

# Flask runtime mode: development | production | testing
FLASK_ENV=development

# Explicit Debug Mode (0 = disabled / production safe, 1 = enabled)
FLASK_DEBUG=0

# Secret key for session encryption, cookies, and CSRF protection (MANDATORY in production)
SECRET_KEY=generate-a-strong-random-hex-string-for-production-use

# Database connection URL (Default: instance/emp.db)
DATABASE_URL=sqlite:///instance/emp.db

# Administrator credentials configured securely via environment
EMP_ADMIN_EMAIL=admin@emp.edu
EMP_ADMIN_PASSWORD=AdminPassword@123
